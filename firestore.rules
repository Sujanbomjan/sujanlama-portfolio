rules_version = '2';

// The portfolio only ever *creates* contact messages. Nobody can read, edit or
// delete them from the browser — review them in the Firebase console instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidMessage(data) {
  return data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
    && data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
    && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
    && data.email is string && data.email.size() <= 200
    && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
    && data.subject is string && data.subject.size() <= 150
    && data.message is string && data.message.size() >= 10 && data.message.size() <= 5000
    && data.createdAt == request.time;
}
