{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sujanlama-portfolio",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "lamasujan.com.np/*", "zone_name": "lamasujan.com.np" },
    { "pattern": "www.lamasujan.com.np/*", "zone_name": "lamasujan.com.np" },
  ],
  "build": {
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
