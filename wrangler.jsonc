{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sujanlama-portfolio",
  "compatibility_date": "2026-09-15",
  "build": {
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
